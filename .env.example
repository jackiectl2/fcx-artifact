# Names and meanings only. Copy to .env (never commit it), fill in values for your site, and export them before submitting jobs.

# Package root on the cluster (the directory that holds fcx/, cluster/, figures/, results/). The job scripts read code from
# $PROJECT_ROOT/fcx, data from $PROJECT_ROOT/data, images from $PROJECT_ROOT/envs and write results to $PROJECT_ROOT/runs.
PROJECT_ROOT=

# Directory that holds the capture samples (cap_<corpus>_s<seed>/) read by cluster/ing_preflight.sbatch and
# cluster/ing_ablate.sbatch. Usually $PROJECT_ROOT/data.
DATA_ROOT=

# Slurm account and partition, passed on the command line: sbatch --account="$SLURM_ACCOUNT" --partition="$SLURM_PARTITION" ...
# (Slurm also reads SBATCH_ACCOUNT and SBATCH_PARTITION from the environment.)
SLURM_ACCOUNT=
SLURM_PARTITION=

# Optional: environment module that provides singularity/apptainer on your cluster (left unset: no module is loaded).
SINGULARITY_MODULE=

# Optional: comma-separated paths bound into the containers (default per script: $PROJECT_ROOT, the job's work directory and,
# for the ingestion jobs, $DATA_ROOT).
SIF_BIND=

# Optional: node-local scratch directory; the job scripts name their work directory there with mktemp (default: the system
# temporary directory of the node).
TMPDIR=

# Per-job variables passed with sbatch --export=ALL,NAME=value (see the usage line at the top of each script in cluster/):
# DATA, OUT, EXTRA (fcx_bench.sbatch); TASKS, TAG, PREFLIGHT (ing_preflight.sbatch, ing_ablate.sbatch); TESTS (fcx_test.sbatch);
# SAMPLES, SLICE (wiki_ingest.sbatch); SAMPLE (duck_bench.sbatch); DATA_ROOT (ing_ablate.sbatch, ing_preflight.sbatch,
# ing_online.sbatch, duck_bench.sbatch: the directory that holds the capture samples).

# Optional: the agent-framework image used by chat_capture.sbatch and chatall_prep.sbatch (default $PROJECT_ROOT/envs/agent-fw-py312-v1.sif).
FW_SIF=

# Capture only: the directory inside the agent-framework image that holds the cached tiktoken encodings (see README.md).
TIKTOKEN_CACHE_DIR=

# Set by cluster/fcx_bench.sbatch itself (a random per-job password of the job-local ClickHouse server): do not set it.
# FCX_CH_PW

# Optional, figures only: force the plotting profile of figures/style.py (ieee or v1); by default it follows the script name.
FCX_STYLE_PROFILE=
